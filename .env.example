# Septimus OS Production Environment Configuration
# Copy this file to .env and set strong, random production secrets.

# Core Database & Message Queue
DB_DSN=postgres://postgres:postgres@db:5432/septimus_db?sslmode=disable
REDIS_URL=redis:6379
NATS_URL=nats://nats:4222

# Security & Authentication Secrets (Generate 64-character random hex strings for production)
JWT_SECRET=supersecretkey_replace_in_production_with_64_char_hex
SETTINGS_ENC_KEY=supersecretkey_replace_in_production_with_32_char_hex
INTERNAL_API_TOKEN=internal_dev_proxy_token_replace_in_production

# Centrifugo Realtime Streaming Secrets
CENTRIFUGO_SECRET=supersecretcentrifugokey_replace_in_production
CENTRIFUGO_API_KEY=supersecretapikey_replace_in_production
CENTRIFUGO_API_URL=http://centrifugo:8000/api
